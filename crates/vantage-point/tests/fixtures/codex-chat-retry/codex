#!/usr/bin/env python3
"""Isolated JSONL peer for the ignored Codex Chat retry integration test."""
import json
import sys
from pathlib import Path

if sys.argv[1:] != ["app-server"]:
    raise SystemExit("this fixture only serves app-server")
root = Path.cwd()
if not (root / "codex-retry-fixture").is_file():
    raise SystemExit("fixture requires the test's isolated working directory")
counter = root / "spawn-count"
attempt = int(counter.read_text()) + 1 if counter.exists() else 1
counter.write_text(str(attempt))


def send(message):
    print(json.dumps(message), flush=True)


for line in sys.stdin:
    request = json.loads(line)
    with (root / "requests.jsonl").open("a") as log:
        log.write(json.dumps({"attempt": attempt, "request": request}) + "\n")
    method = request.get("method")
    request_id = request.get("id")
    if method == "initialize":
        send({"id": request_id, "result": {}})
    elif method == "thread/resume":
        if attempt == 1:
            send({"id": request_id, "error": {"code": -32603, "message": "fixture resume unavailable"}})
        else:
            send({"id": request_id, "result": {"thread": {"id": request["params"]["threadId"]}}})
    elif method == "turn/start":
        send({"id": request_id, "result": {"turn": {"id": "retry-turn"}}})
        send({"method": "turn/completed", "params": {"turn": {"id": "retry-turn", "status": "completed"}}})
    elif method == "thread/start":
        # Old VP behavior is observable as an Error, without ever creating a real thread.
        send({"id": request_id, "error": {"code": -32603, "message": "unexpected fresh start"}})
