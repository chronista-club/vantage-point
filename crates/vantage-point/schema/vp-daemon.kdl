// vp-daemon channel の wire protocol を記述する KDL（runtime discovery 用）。
//
// 目的:
//   VP daemon（daemon、Unison ProtocolServer "vp-daemon"）が起動時に enable_discovery で
//   この KDL を unison.discovery channel から配信する。無改造の unison-mcp（Unison Protocol の
//   runtime discovery + typed tool 合成 MCP bridge、v1.1.0+）が runtime fetch して
//   `unison_<channel>_<method>` の typed tool を合成できるようにする。VP 開発のデバッグ機。
//
// 位置づけ（重要 — schema/vp-agent.kdl とは別物）:
//   vp-agent.kdl = agent action space の SSOT（build-time codegen でキュレーション済み MCP tool を
//   生成）。vp-daemon.kdl = 「daemon channel の wire protocol の記述的スキーマ」。現行のキュレー
//   ション済み MCP を置き換えない（別プロセス・別 tool namespace の dev/dogfood 面）。
//   設計判断: docs/design/27-apple-surface-lifecycle.md §5、handoff mem_1Ccu5RK4VMT7xjaMxm9JXM。
//
// 制約（drift 防止）:
//   - request 名 = wire の msg.method と文字列一致必須（記述的スキーマ。リネーム = 既存 client 破壊）。
//     SSOT: crates/vantage-point/src/daemon/server.rs の各 channel handler の `match method`。
//   - channel 名 ⊆ daemon が register_channel する集合。drift 検出は tests/vp_daemon_kdl.rs。
//   - request の description / field の description は synthesized tool の description に昇格する
//     （unison-mcp mapping.rs、formulaic を override）ので agent 品質で書く。
//   - method レベルの網羅・追随は当面手動同期（将来 daemon dispatch 側も KDL codegen 化 =
//     doc 27「1 protocol」方向。open）。
//
// starter set（2026-07-11 user 確定 → Phase1 は registry + events を先行）:
//   handshake なしの純 request/response ＝ 無改造 unison-mcp で即 round-trip 可能な channel を採用。
// 2026-11-21 拡張: repo-proxy は最初の request の repo_path で暗黙 bind できる。
//   subscribe を送らない unison-mcp からも利用可（対象 repo の起動は必要）。既存の
//   subscribe 方式も維持する。公開は session_set_mode / lanes_list と chat session の作成・削除に限定する。
// 2026-07-12 拡張: daemon-control の read-safe subset（hub/discover）を追加 — hub registry の
//   nodes 一覧 + connected liveness（hub protocol v0.7.0）を MCP から照会可能にする。
//   repos/* mutation は手で叩くと repos.kdl 状態を壊すため記述しない（registry と同じ方針）。
// 2026-11-24 v0.5.0: handler の失敗は Error frame（UnisonChannel::send_error、payload は
//   {error: string}）で返す。失敗を成功の response payload の {error} で返す旧形式は使わない
//   （lane/prs の error のような、成功応答の中の状態データは別。
//   docs/design/27-apple-surface-lifecycle.md §3.4.7）。

protocol "vp-daemon" version="0.5.0" {
    namespace "club.chronista.vantage-point"

    // repo-proxy: channel ごとに最初の repo_path に固定し、repo dispatcher へ渡す。
    // この 4 method だけを allowlist として tests/vp_daemon_kdl.rs で固定する。
    // 他の repo method は既定で非公開。追加する時に露出の判断と test を一緒に変更する。
    // handler のエラーは Error frame（payload は {error: string}）で返る。
    channel "repo-proxy" from="client" lifetime="persistent" {
        request "conversation_session_create" readonly=#false description="起動済み repo の lane に chat（gui）の session を作る。console の作成ではない。作成の操作そのものは engine を起動しない。発言時に起動するが、GUI が開いていると pane の attach や注視で発言前に起動することがある。agent 省略時は lane の agent を使い、focus 省略時は true（新 session に lane の注視を移す）。lane は lanes_list で確認する。subscribe は不要。" {
            field "repo_path" type="string" required=#true min_length=1 description="対象 repo の絶対 path。最初の request で channel の宛先を固定する。"
            field "lane" type="string" required=#true min_length=1 description="lane address（例 vantage-point/lane/lead）。lanes_list の address.repo/address.name でも指定できる。"
            field "agent" type="string" pattern="^(claude|codex|grok|opencode|agy|muse|vpcode)$" description="claude / codex / grok / opencode / agy / muse / vpcode。省略時は lane の agent。shell など未対応の agent は、省略時に引き継いだ場合もエラー。"
            field "focus" type="bool" default="true" description="true は新 session に lane の注視を移す。false は作成操作では元の注視先を保つが、GUI 側の操作で後から注視が移ることがある。省略時は true。"
            returns "SessionCreateAck" {
                field "status" type="string" required=#true description="成功時は ok。"
                field "lane" type="string" required=#true description="指定した lane address。"
                field "session" type="int" required=#true description="作成した session key。削除や表示切替ではこの値を指定する。"
            }
        }
        request "conversation_session_remove" readonly=#false description="起動済み repo の lane から指定 session を閉じ、稼働中の engine / terminal も停止する。root session の削除と lane 不在は error を返す。既に無い session は status=absent、focused=null で冪等に成功する。通常は status=ok と削除後の focused key を返す。注視中の session を閉じると残りの先頭へ注視を移す。subscribe は不要。" {
            field "repo_path" type="string" required=#true min_length=1 description="対象 repo の絶対 path。最初の request で channel の宛先を固定する。"
            field "lane" type="string" required=#true min_length=1 description="lane address（例 vantage-point/lane/lead）。lanes_list の address.repo/address.name でも指定できる。"
            field "session" type="int" required=#true min=1 max=4294967295 description="閉じる session key。作成応答の session または lanes_list の sessions.sessions[].key。sessions.root は削除できない。"
            returns "SessionRemoveAck" {
                field "status" type="string" required=#true description="削除時は ok、既に無い session は absent。"
                field "lane" type="string" required=#true description="指定した lane address。"
                field "session" type="int" required=#true description="削除を指定した session key。"
                field "focused" type="json" required=#true description="ok 時は削除後の注視先 session key（1〜4294967295 の整数）。absent 時は null（注視先の不在を意味しない。現在の注視先は lanes_list で確認する）。"
            }
        }
        request "session_set_mode" readonly=#false description="指定 session の表示を console（tui）または chat（gui）に切り替える。対象 repo は起動済みであること。lane と session は lanes_list の address / sessions.sessions から選ぶ。切替は現在の engine や terminal の起動・停止を伴う。subscribe は不要。" {
            field "repo_path" type="string" required=#true min_length=1 description="対象 repo の絶対 path。最初の request で channel の宛先を固定する。"
            field "lane" type="string" required=#true description="lane address（例 vantage-point/lead）。lanes_list の address.repo と address.name を / で結ぶ。"
            field "session" type="int" required=#true min=1 max=4294967295 description="切り替える session key。lanes_list の sessions.sessions[].key で確認する。省略不可。"
            field "mode" type="string" required=#true pattern="^(tui|gui)$" description="tui = console、gui = chat。"
            returns "SessionModeAck" {
                field "status" type="string" required=#true description="成功時は ok。"
                field "lane" type="string" required=#true description="指定した lane address。"
                field "session" type="int" required=#true description="切り替えた session key。"
                field "mode" type="string" required=#true description="確定した mode（tui|gui）。"
            }
        }
        request "lanes_list" readonly=#true description="起動済み repo の lane 一覧を読む。各 lane の address と sessions.sessions（key / mode）で切替先を特定し、session_set_mode の前後を確認できる。subscribe は不要。" {
            field "repo_path" type="string" required=#true min_length=1 description="対象 repo の絶対 path。最初の request で channel の宛先を固定する。"
            returns "RepoLaneList" {
                field "lanes" type="json" required=#true description="LaneInfo の配列。address、slots（稼働中 terminal の session key）を含む。session view がある場合は sessions.sessions に各 session の key / mode が入る。"
            }
        }
    }

    // registry channel: repo 自己登録 + running process / lane registry の control plane。
    // handler: server.rs register_channel("registry", ...)（match method: register / unregister /
    // heartbeat / list / lanes/add / lanes/remove / lanes/update）。
    // starter では read-safe な `list` のみ記述する。register / unregister / heartbeat は repo 内部用
    //（手で叩くと registry 状態を壊す）、lanes/* は mutation なので follow-up で記述する。
    channel "registry" from="client" lifetime="persistent" {
        request "list" description="VP daemon に登録中の全 running process（repo / 各 repo の repo）の snapshot を返す read-only 照会。`vp ps` 相当を daemon から直接引く。引数なし。" {
            returns "ProcessList" {
                field "processes" type="json" required=#true description="running process の配列。各要素は { repo_name, port, pid, repo_path }。"
            }
        }
    }

    // daemon-control channel: daemon 権威の control plane（CLI → Daemon 直接 Unison）。
    // handler: server.rs handle_daemon_control（match method: repos/* + lanes/* + hub/discover + ping）。
    //
    // ここには read-safe な request だけ記述する（hub/discover / lanes/list）。mutation は
    // 手で叩くと repos.kdl / lane descriptor の状態を壊すため記述しない（unison-mcp に
    // 露出させない）。この「意図的に書かない」判断は tests/vp_daemon_kdl.rs の
    // DAEMON_CONTROL_OMITTED_BY_DESIGN と対になっていて、handler に method を足したのに
    // KDL にも omission list にも入れなかった場合はテストが落ちる（= 露出/非露出を
    // 無意識に決めてしまうことを防ぐ）。
    //
    // doc 45 段 1（2026-07-22）: HTTP `/api/daemon/*` にしか無かった面を handler へ移設した
    // （repos/update・repos/sync・repos/reload・repos/restart・repos/pointview・
    // lanes/create・lanes/set_active）。全て mutation なので上記方針どおり omission 側に置く。
    channel "daemon-control" from="client" lifetime="persistent" {
        request "hub/discover" description="chronista-hub registry に登録された daemon 一覧を返す federation discovery。daemon が credential 付きで hub の nodes.Discover を叩く（SSOT: hub と話すのは daemon のみ）。各 entry の connected (bool) は hub との常駐接続が今生きているかの liveness — false は registry に居るが relay は offline を返す (stale / 切断中)。hub addr 未設定（env CHRONISTA_HUB_ADDR / config.kdl hub-addr）ならエラーを返す。引数なし。" {
            returns "DaemonList" {
                field "nodes" type="json" required=#true description="daemon の配列。各要素は { node_id, handle, name, endpoints[], registered_at, connected }。connected=true は relay 到達可、false は offline (stale entry / 切断中)。"
            }
        }
        request "lanes/list" description="全 repo 横断の lane 一覧を返す read-only 照会。各 lane は repo / name (開発起点は予約名 root) / agent / state (spawning|running|exiting|dead) を持つ。`vp ps` の LANES / STATUS 列や外部 agent の俯瞰に使う。repo 単位の詳細操作は repo-proxy 経由。全ての引数は省略可で、省略 = 絞り込みなし。並びは repo 名昇順 → 同 repo 内は開発起点 (root) が先 → 作成順。" {
            field "repo" type="string" description="repo 名で絞り込む（LaneAddress.repo と完全一致）。省略時は全 repo。"
            field "lane" type="string" description="lane 名で絞り込む（開発起点は予約名 \"root\"、sub は作成時の名前）。省略時は全 lane。"
            field "agent" type="string" description="agent で絞り込む（例 \"claude\" / \"shell\"）。省略時は全 agent。"
            returns "LaneList" {
                field "count" type="int" required=#true description="filter 適用後の lane 件数（lanes 配列の長さ）。"
                field "lanes" type="json" required=#true description="LaneInfo の配列。各要素は { address: { repo, name }, state, agent, ... }。"
            }
        }
        request "lane/prs" description="lane の repo の open PR 一覧を返す read-only 照会（doc 82、R sidebar の中央の節）。裏は当面 `gh pr list` を lane の cwd で実行する。gh 不在なら available=false（エラーではない）、gh はあるが失敗したら available=true + error。応答は gh の形を漏らさない正規化済みの形。" {
            field "path" type="string" required=#true description="lane の cwd（worktree の絶対 path）。"
            returns "LanePrs" {
                field "available" type="bool" required=#true description="一覧を引く手段（gh）が在るか。false なら GUI は PR 節ごと出さない。"
                field "branch" type="string" description="lane の cwd の現在の branch。detached / 不明なら null。"
                field "prs" type="json" required=#true description="open PR の配列。各要素は { number, title, url, draft, head, ci: pass|fail|pending|none, review: approved|changes_requested|review_required|none }。"
                field "error" type="string" description="取得に失敗した理由。成功時は省略。"
            }
        }
        request "settings/get" description="user の「好み」設定（~/.config/vp/settings.kdl）を返す read-only 照会。doc 59 の 3 層のうち『好み』の層で、環境（config.kdl = claude-cli-path / hub-addr）とはキーが重複しない。各値は「書かれていなければ省略」= 未設定と明示値を区別する。引数なし。" {
            returns "UserSettings" {
                field "log_level" type="string" description="ログ詳細度（trace|debug|info|warn|error）。未設定なら省略。⚠️ daemon の起動時にしか読まれないので、変更の反映には daemon 再起動が要る。"
                field "idle_timeout_minutes" type="int" description="アイドルとみなすまでの分数。未設定なら省略（既定 5 分）。**1 つの値が 2 つの振る舞いを決める** — sidebar の now-line が『⏸N分』に沈む閾値（client 判定）と、見ていない lane の chat engine を落とす猶予（daemon 判定）。"
                field "default_agent" type="string" description="新しい lane の既定 agent（claude | codex）。未設定なら省略（既定 claude）。"
                field "default_model" type="string" description="新しい lane の既定 model alias。**agent が model を受け付ける場合のみ**意味を持つ（codex は VP から model を渡さないので設定できない）。未設定なら省略。"
                field "default_agent_takes_model" type="bool" required=#true description="実効 agent が VP からの model 指定を受け付けるか。判定の源は engine の能力表明（EngineKind::model_choices が空 = 受け付けない）。client はこれが false なら model 欄を出さない（押しても効かない欄を並べない）。"
            }
        }
        request "settings/set" description="user の「好み」設定を書き換える。**daemon が唯一の書き手**（GUI / CLI はこの RPC に頼む）で、atomic write により partial read が起きない。指定しなかった field は不変、空文字を渡すとその key を消す（= 未設定に戻して組み込み既定へ倒す）。書き込み後の確定値を返すので、呼び手は楽観更新をしなくてよい。" {
            field "log_level" type="string" description="ログ詳細度（trace|debug|info|warn|error）。空文字 = 未設定に戻す。綴り違いはエラーを返す（黙って捨てると『設定したのに効かない』になる）。"
            field "idle_timeout_minutes" type="int" description="アイドルとみなすまでの分数（1 以上）。0 はエラー — 『無効化』の意味を持たせず、1 つの値に時間と有効/無効の 2 性質を兼ねさせないため。"
            field "default_agent" type="string" description="新しい lane の既定 agent。claude | codex のみ（doc 59 P4、mako 裁定）。空文字 = 未設定に戻す。それ以外はエラー。"
            field "default_model" type="string" description="新しい lane の既定 model alias。空文字 = 未設定に戻す。**その agent が model を受け付けない場合はエラー**（保存しても無視されるだけの値を黙って書かない）。"
            returns "UserSettings" {
                field "log_level" type="string" description="書き込み後の確定値。未設定なら省略。"
                field "idle_timeout_minutes" type="int" description="書き込み後の確定値。未設定なら省略。"
                field "default_agent" type="string" description="書き込み後の確定値。未設定なら省略。"
                field "default_model" type="string" description="書き込み後の確定値。未設定なら省略。"
                field "default_agent_takes_model" type="bool" required=#true description="書き込み後の実効 agent が model を受け付けるか。"
            }
        }
        request "host/farewell_log" description="Repo Host の帳簿から見送りの記録を新しい順に返す read-only 照会（doc 44 §7.5）。kind='reclaimed' が「いつ何を見送ったか」、kind='pending' が「人の判断待ちがいつから何回続いているか」。lane_name は記録時点のスナップショット（key は lane_id なので rename でも履歴は動かない）。" {
            field "path" type="string" required=#true description="対象 repo の path（内部で正規化して照合する）。"
            field "limit" type="int" description="返す件数の上限。0 / 省略は無制限。"
            returns "FarewellLog" {
                field "entries" type="json" required=#true description="記録の配列（last_seen_at の降順）。各要素は { lane_id, lane_name, kind: reclaimed|pending, reason, streak, first_seen_at, last_seen_at, ongoing }。streak は同じ判定が連続した回数（実行回数であって日数ではない）。"
            }
        }
    }

    // events channel: daemon の event log（doc 27 §5-3。process.up / process.down を baseline に蓄積、
    // build/test 等の追加 source は follow-up）。
    // handler: server.rs register_channel("events", ...)（match method: emit / query）。
    channel "events" from="client" lifetime="persistent" {
        request "query" description="daemon の event log を時系列で照会する read-only 面。seq が `since` より後の event を最大 `limit` 件返す（seq 昇順）。" {
            field "since" type="int" description="この seq より後の event を返す。0 なら先頭から。"
            field "limit" type="int" description="取得件数の上限。0 は無制限。"
            returns "EventPage" {
                field "events" type="json" required=#true description="event の配列（seq 昇順）。各要素は { seq, kind, source?, data, ... }。"
            }
        }

        request "emit" description="任意の event を daemon の event log に注入する（dogfood / デバッグ用の手動 emit）。" {
            field "kind" type="string" required=#true description="event 種別（例 \"process.up\" / \"build.start\"）。空文字は拒否される。"
            field "source" type="string" description="発生源ラベル（任意、例 repo 名）。"
            field "data" type="json" description="任意の付随データ（JSON オブジェクト等）。"
            returns "EmitAck" {
                field "seq" type="int" required=#true description="採番された単調増加の event seq。"
            }
        }
    }

    // link channel: Editor Link hub（doc 86）。面（creo-ui editor-host を載せた画面 = vp-app の webview /
    // Chrome の creo-ui site）は HTTP `/link` の WebSocket で daemon に繋がり、この channel はその面を
    // AI から読み書きする口。MCP editor_* の着地点。
    // handler: server.rs register_channel("link", ...) → daemon::link::handle_link_channel
    // （match method: surfaces / editor_fields / editor_values / editor_set）。
    channel "link" from="client" lifetime="persistent" {
        request "surfaces" description="繋がっている Editor Link の面の一覧と active な面を返す read-only 照会。active = 最後に Editor Mode を ON にした面（無ければ最後に繋いだ面）。引数なし。" {
            returns "LinkSurfaces" {
                field "surfaces" type="json" required=#true description="面の配列。各要素は { surface, app, mode: on|off, fields: 件数, active: bool }。surface 名の昇順。"
                field "active" type="string" description="active な面の surface id。面が無ければ null。"
            }
        }
        request "editor_fields" description="面の Editor Mode field 一覧を返す。面に get を送り、面が values を返した時点の全量（authoritative）。3 秒で timeout。" {
            field "surface" type="string" description="面の id か名札（hello.app、大文字小文字無視）。省略 = active な面。"
            returns "EditorFields" {
                field "surface" type="string" required=#true description="解決した面の id。"
                field "app" type="string" required=#true description="面の名札（hello.app）。"
                field "mode" type="string" required=#true description="面の Editor Mode（on|off）。"
                field "fields" type="json" required=#true description="LinkField の配列（id / label / type / semantic / constraints / initial / cssVar など、creo-ui docs/design/editor-link.md の形そのまま）。"
            }
        }
        request "editor_values" description="面の Editor Mode field の現在値と selection を返す。editor_fields と同じ get の往復。" {
            field "surface" type="string" description="面の id か名札。省略 = active な面。"
            returns "EditorValues" {
                field "surface" type="string" required=#true description="解決した面の id。"
                field "app" type="string" required=#true description="面の名札。"
                field "mode" type="string" required=#true description="面の Editor Mode（on|off）。"
                field "selection" type="json" description="選択中なら { targetId, fieldIds, componentId? }、無ければ null。"
                field "values" type="json" required=#true description="field id → 値 の map（型は field.type のまま、数は数で返る）。"
            }
        }
        request "editor_set" description="面の field に値を書く（画面に即時反映、永続はしない）。number は field の constraints.min / max に収めてから送り、適用した値を返す。面が知らない id はエラー。" {
            field "id" type="string" required=#true description="field id（editor_fields が列挙する id）。"
            field "value" type="json" required=#true description="新しい値（number / bool / string）。文字列化しない。"
            field "surface" type="string" description="面の id か名札。省略 = active な面。"
            returns "EditorSetAck" {
                field "ok" type="bool" required=#true description="常に true（失敗は error で返る）。"
                field "surface" type="string" required=#true description="書いた面の id。"
                field "id" type="string" required=#true description="書いた field id。"
                field "value" type="json" required=#true description="適用した値（clamp 後）。"
                field "clamped" type="bool" required=#true description="constraints に収めるために値が変わったか。"
            }
        }
    }
}
