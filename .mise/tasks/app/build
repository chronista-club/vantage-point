#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="vp-app GUI binary を release build + ~/.cargo/bin に install (codesign 付与、 PATH 経由でも fresh)"
#
# file-based mise task 移行 (2026-05-30)。 旧 [tasks."app:build"] を Ruby file task に移植。
# cargo install --path で codesign 付き binary を ~/.cargo/bin に配置 (cp だと codesign 剥がれて
# macOS に kill される、 CLAUDE.md feedback)。 build artifact (target/) も副産物で生成される。
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

VP.log "Building vp-app (release) + install to ~/.cargo/bin…"
VP.sh "cargo install --path crates/vp-app"
VP.log "#{VP.icon(:ok)} Installed: #{VP.cargo_bin('vp-app')}"
