#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="frontend (web-bundle) を esbuild watch で常時 rebuild — VP_WEBVIEW_DEV 起動の app と組で HMR loop (cargo 不要)"
#
# vp-app は web-bundle を include_bytes! で binary に焼き込むため、 通常は frontend 変更に
# cargo build が要る。 dev loop (cargo 不要):
#   1. (初回のみ) dev-read 対応 binary を install:  ge app:build
#   2. assets dir を env に固定:                      export VP_WEBVIEW_DEV=<assets dir>
#   3. dev-read app を起動 (rebuild 無し):            ge app:start
#   4. この task で esbuild watch を常駐:             ge dev
#   → 以後 frontend を編集 → ~0.5s rebuild → reload で反映 (cargo 不要)。
#     reload は当面 relaunch (`ge app:stop && ge app:start`、 rebuild 無しで秒)。
#     in-place auto-reload (file watch → location.reload) は follow-up。
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

assets = File.join(VP.root, "crates", "vp-app", "assets")
VP.log "frontend watch (esbuild) 起動 — 編集 → ~0.5s rebuild"
VP.log "未設定なら別 terminal で (初回のみ `ge app:build` で dev-read binary を install):"
warn "    export VP_WEBVIEW_DEV='#{assets}'"
warn "    ge app:start                       # dev-read app 起動 (rebuild 無し)"
warn "    # 反映するとき: ge app:stop && ge app:start"
warn ""
Dir.chdir(File.join(VP.root, "crates", "vp-app", "web-bundle"))
VP.exec("bun", "run", "dev")
