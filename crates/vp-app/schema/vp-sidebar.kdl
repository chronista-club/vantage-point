// vp-app sidebar IPC protocol schema — SSOT (VP-208 Phase A)
//
// sidebar webview (SolidJS) → Rust の IPC メッセージ `SidebarIpcMsg` を、
// この KDL を唯一の真実として club-kdl-codegen で生成する:
//
//   - Rust enum  → crates/vp-app/src/generated/sidebar_ipc.rs  (`IpcEnvelope`)
//   - TS union   → crates/vp-app/webview/src/generated/SidebarIpc.ts
//
// 生成は `cargo test -p vp-app --test sidebar_ipc_codegen` で走る
// (tests/sidebar_ipc_codegen.rs)。 手書き側 (webview/src/sidebar/ipc.ts の
// `SidebarIpcMsg` / app.rs の `handle_sidebar_ipc`) の移行は PR-2 / PR-3。
//
// 全 request は client → server。 serde tag フィールド名 = "t"。

protocol "sidebar" version="1.0.0" {
    namespace "vp.sidebar"

    // channel "ipc": envelope="t" で全 request を束ねる discriminated union
    // (`IpcEnvelope`) を生成する。 transient = request ごとに完結 (response 無し)。
    channel "ipc" from="client" lifetime="transient" envelope="t" {
        // Currents セクションの repo accordion 開閉 (+ repo auto-spawn 連動)
        request "process:toggle" {
            field "path" type="string"
            field "expanded" type="bool"
        }
        // Currents の drag-and-drop 並び替え通知
        request "process:reorder" {
            field "order" type="array<string>"
        }
        // Process restart 要求
        request "process:restart" {
            field "path" type="string"
        }
        // Process stop 要求 (repo を停止。 repo は registered のまま →
        // 一時停止中 tab へ移動。 enabled フラグは不変、 repo プロセスだけ落とす)
        request "process:stop" {
            field "path" type="string"
        }
        // Repo delete 要求 (repo 停止 + repos.kdl から unregister。
        // 破壊的なので UI 側で 2-click 確認済。 repo ディレクトリ自体は消さない)
        request "repo:delete" {
            field "path" type="string"
        }
        // sidebar の repo 追加ボタン (fieldless)
        request "repo:add" {}
        // Lane row click → main area に対応 pane を表示
        request "lane:select" {
            field "path" type="string"
            field "address" type="string"
        }
        // Sub Lane 削除要求
        request "lane:delete" {
            field "path" type="string"
            field "address" type="string"
        }
        // Lane Main Agent restart 要求
        // fresh=true は resume/continue を回避し fresh な claude を起動する
        // (sidebar "New Main Session")。 省略時は従来通り --resume で会話を継ぐ。
        request "lane:restart" {
            field "path" type="string"
            field "address" type="string"
            field "fresh" type="bool" optional=#true
        }
        // doc 39 §8.4 提案 2: 新しい root conversation を始める (非破壊)。
        // Rust 側が repo の `conversation_session_new_root` を呼ぶ — 新 session を採番して
        // root に向け、旧 root の会話は session として残る (Reset Lane との対比が要点)。
        request "lane:new_root" {
            field "path" type="string"
            field "address" type="string"
        }
        // doc 44 D4: この lane を repo の開発起点にする (Host の帳簿のポインタ更新)。
        // D5 の通り **何も動かさない** — cwd も active lane も engine も変わらない。
        request "lane:set_origin" {
            field "path" type="string"
            field "address" type="string"
        }
        // doc 44 §12: lane の並び順を帳簿に保存する (sidebar の DnD)。
        // order = lane address の配列 (表示順)。server 側で lane 名 → lane_id に解決される。
        request "lane:reorder" {
            field "path" type="string"
            field "order" type="array<string>"
        }
        // Sub Lane 作成要求 (branch / agent は optional)
        request "lane:add_sub" {
            field "path" type="string"
            field "name" type="string"
            field "branch" type="string" optional=#true
            field "agent" type="string" optional=#true
        }
        // + Add Sub form の利用可能 Agent 一覧 fetch
        request "agents:fetch" {
            field "path" type="string"
        }
        // Repo-scope Agent row click → main area に対応 pane を表示
        request "stand:select" {
            field "path" type="string"
            field "kind" type="string"
        }
        // Clone 用フォルダ picker を開く要求 (fieldless)
        request "repo:clone:pickFolder" {}
        // Wire inbox (doc 34 §4 V1): 選択 lane の wire 履歴を read-only で取得。
        // Rust が Daemon "wire" channel に wire/history + wire/unread-count を request し、
        // 結果を window.vpWire.handleResult で push back する (cursor 不触り)。
        request "wire:fetch" {
            field "path" type="string"
            field "address" type="string"
        }
        // Wire inbox: message を lane の agent として ack (処理済み宣言)。
        // ack 成功後に Rust が再 fetch して handleResult で最新状態を push back する。
        request "wire:ack" {
            field "path" type="string"
            field "address" type="string"
            field "message_id" type="string"
        }
        // in-app update: sidebar の「更新する」ボタン click。 Rust 側で macOS ネイティブ
        // 確認ダイアログ (rfd) を出し、 OK なら self-update (brew / vp update) →
        // `vp daemon restart` → GUI relaunch を実行する (update_flow.rs)。
        // version = 適用予定の latest version (ダイアログ文言用)。
        request "update:apply" {
            field "version" type="string"
        }
        // Login ボタン: `vp auth login --for <target>` (browser OAuth) を spawn し、 成功後に
        // daemon-control.hub/reconnect で hub 接続へ即反映する (auth_flow.rs)。
        //
        // `target` = token の宛先 ("hub" | "creo")。**identity は 1 つ（Creo ID）だが
        // access_token は aud claim で宛先が固定される**ため、宛先ごとに 1 本ずつ要る
        // (doc 57 §6「なぜ hub の token を流用できないか」)。省略 = "hub"（従来の挙動）。
        // 2 本目以降は Auth0 の session cookie で素通りするので、体感は「一瞬開いて閉じる」。
        request "auth:login" {
            field "target" type="string" optional=#true
        }
        // Logout ボタン: macOS ネイティブ確認ダイアログ (rfd) → `vp auth logout [--for <target>]`
        // → hub/reconnect。 hub を切ると接続は匿名に落ちる (permissive hub なら接続自体は維持)。
        //
        // `target` 省略 = **全宛先を捨てる**（= 完全 logout）。creo だけ切りたい等は明示する。
        request "auth:logout" {
            field "target" type="string" optional=#true
        }
        // ── 設定ページ（doc 59 P1）─────────────────────────────────────────
        // 設定 overlay の現在値 fetch。応答は `settings:result`（WirePanel の
        // `wire:fetch` と同じ流儀 — 開いた時に取りに行き、常時 push はしない）。
        request "settings:fetch" {}
        // 設定の保存。**変えた field だけ**を送る（省略 = 不変）。Rust 側が
        // `vp-app.toml` へ atomic に書き、確定値を `settings:result` で push back する
        // （楽観更新の巻き戻しを client に持たせない）。
        request "settings:save" {
            field "developer_mode" type="bool" optional=#true
            field "default_repo_root" type="string" optional=#true
            // ── ここから下は daemon 側（settings.kdl）の設定。vp-app は
            //    daemon-control.settings/set に中継するだけで、自分では書かない
            //    （書き手は daemon 唯一 — doc 59 §3）。
            field "log_level" type="string" optional=#true
            field "idle_timeout_minutes" type="int" optional=#true
        }
        // Add Repo 初期フォルダの folder picker を開く。選択されたら保存して
        // `settings:result` を返す。⚠️ **キャンセル時は撃たない**
        // （`repo:clone:pickFolder` と同じ流儀 = 既存値を保持）。
        request "settings:pick_repo_root" {}
        // daemon 再起動要求。⚠️ **全 repo = 全 lane の claude が落ちる**
        // （doc 44 P1 fold-in で repo は daemon プロセス内の `Arc<AppState>`）。
        // Rust 側が rfd 確認ダイアログで「何が落ちて何が戻るか」を出してから
        // `vp daemon restart` を撃つ（`update_flow.rs` と同じ専用スレッド）。
        request "daemon:restart" {}

        // ACTIONS の永続化 (doc 57 Phase 4)。sidebar の編集を daemon 経由で creo-memories へ。
        //
        // Rust 側は 400ms coalesce してから `daemon-control.actions/save` を撃つ (打鍵ごとに
        // 外部 HTTP を出さない)。**daemon が書く**のは、cache の持ち主が書かないと
        // 「書いたのに次の push で戻る」が起きるから (doc 57 §4)。
        //
        // - `items` = 現在の一覧 **全件**。要素の形の持ち主は Rust `creo::client::CreoAction`
        // - `removed` = user が明示的に消した id。⚠️ **`items` の不在からは決して削除しない**
        //   (webview の一覧は push 到着前に短く見えることがあり、推論すると全消しになる)
        request "actions:persist" {
            field "items" type="array<json>"
            field "removed" type="array<string>"
        }

        // ===================================================================
        // server → client（Rust が sidebar bundle へ押し込む）
        // ===================================================================
        //
        // channel は両方向を運ぶので、request（client → server）と同じ channel に置く。
        // 生成される envelope は別名（`IpcEnvelope` / `IpcEventEnvelope`）。
        //
        // ⚠️ **なぜ main の `vp-push.kdl` に相乗りしないか** — webview は 1 document だが
        // bundle は 2 本（`editor-host.bundle.js` / `sidebar.bundle.js`）で、module state を
        // 共有できない。`dispatch.ts` の保留箱は main bundle の中にあるので、sidebar 側の
        // 受け手をそこへ登録する術がない。**bundle が受け口の単位**なので、sidebar は
        // 自分の受け口（`window.vpSidebarDispatch`）を持つ。
        //
        // ⚠️ 旧来はここも `window.renderSidebarState(...)` のように**名前で関数を呼ぶ**形で、
        // ①型が無い ②bundle 未評価の間は `window.X &&` guard が黙って捨てる、の 2 つの負債が
        // あった（doc 53 §6.5.1.3）。

        // sidebar の全 state を push する唯一の経路。
        // ⚠️ **`state` の形の持ち主は Rust の `SidebarState`**（ts-rs が
        // `webview/src/generated/SidebarState.ts` を出す）。KDL にも書くと二重定義になるので
        // ここでは `json` にし、受け側 1 箇所で `SidebarState` に落とす。
        event "sidebar:state" {
            field "state" type="json"
        }

        // daemon 接続失敗等の error 表示。
        event "sidebar:error" {
            field "message" type="string"
        }

        // + Add Sub の作成結果。`error` 省略 = 成功（form を閉じる）。
        event "sub:create_result" {
            field "repo_path" type="string"
            field "name" type="string"
            field "error" type="string" optional=#true
        }

        // + Add Sub の dropdown を populate する Agent 一覧（`agents:fetch` の戻り）。
        // 要素の形の持ち主は Rust `client::AgentInfo`。
        event "agents:result" {
            field "repo_path" type="string"
            field "agents" type="array<json>"
            field "error" type="string" optional=#true
        }

        // Wire inbox の履歴（`wire:fetch` / `wire:ack` の戻り）。
        event "wire:result" {
            field "payload" type="json"
        }

        // Clone 用フォルダ picker の選択結果（`repo:clone:pickFolder` の戻り）。
        // ⚠️ **キャンセル時は撃たない**（既存の override を保持する = 既存挙動）。
        event "clone:path_picked" {
            field "path" type="string"
        }

        // 設定の現在値（`settings:fetch` / `settings:save` / `settings:pick_repo_root` の戻り、
        // doc 59 P1）。
        //
        // - `developer_mode` = **実効値**（env > vp-app.toml > debug_assertions の解決後）
        // - `developer_mode_locked` = `VP_DEVELOPER_MODE` で固定されている（= 設定ページで
        //   変えても効かない）。UI はこの時 toggle を無効化する — 「押しても効かない
        //   選択肢を並べない」ため
        // - `default_repo_root` = vp-app.toml の明示値（未設定なら省略）
        // - `resolved_repo_root` = 明示値が無い時に**実際に使われる**パス
        //   （`resolve_default_repo_root` の推定結果）。空欄の入力欄に placeholder として
        //   出し、「空だが実際はここ」を見せる
        event "settings:result" {
            field "developer_mode" type="bool"
            field "developer_mode_locked" type="bool"
            field "default_repo_root" type="string" optional=#true
            field "resolved_repo_root" type="string" optional=#true
            // ── daemon 側（settings.kdl）の確定値。**daemon 不在なら省略**され、
            //    UI はその区画を「daemon に接続すると編集できます」に落とす
            //    （空欄に見せて編集させると、押しても保存できない行き止まりになる）。
            field "log_level" type="string" optional=#true
            field "idle_timeout_minutes" type="int" optional=#true
            field "daemon_reachable" type="bool"
        }
    }
}
