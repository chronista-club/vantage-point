#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="daemon を停止 (= 全 project + lane も停止。旧 cascade nuke 相当)"
#
# 2026-05-30 daemon→world 改名。
# tmux decoupling PR2: 旧 tmux session kill phase は退役 (lane は PtySlot の子)。
# doc 44 P1 (fold-in): 旧 2-phase cascade ([1/2] SP を TERM→KILL → [2/2] daemon stop) の
#   前段を撤去した。project が World プロセス内の Arc<AppState> になり、**独立した SP
#   プロセスが存在しなくなった**ため、pgrep 'vp sp start' は永久に 0 件マッチで、
#   phase [1/2] は「エラーも出さず何もしない」空振りになっていた。
#   現在は `vp daemon stop` 自体が World の graceful shutdown で全 project を畳むので、
#   cascade は daemon stop 一手で成立する。
#
# ⚠️ fold-in 後は「gentle な停止」(daemon だけ止めて project は温存) が原理的に存在しない。
#    このタスクは必ず全 lane の claude を落とす。VP の lane の中から回すと自分が死ぬ。
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

vp = VP.cargo_bin("vp")

VP.log "#{VP.icon(:bomb)} daemon 停止 (profile=#{ENV['VP_PROFILE'] || 'brew'}、 全 project + lane も停止)…"

if ENV["VP_LANE"]
  warn "   #{VP.icon(:warn)} VP の lane の中から実行しています — この停止で自分自身も落ちます"
  warn "      会話は cc_session の --resume で次回 spawn 時に継がれます"
end

if File.executable?(vp)
  if system(vp, "daemon", "stop", out: File::NULL, err: File::NULL)
    VP.log "#{VP.icon(:ok)} daemon stop 完了。 再起動: mise run app"
  else
    VP.log "#{VP.icon(:info)} daemon は既に停止しているか、 reach 不能"
  end
else
  warn "   #{VP.icon(:warn)} vp binary 不在 (#{vp}) — daemon stop スキップ"
  warn "      build 済なら `mise run daemon:build` 後に再実行してください"
end
