#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Mac silicon (vp + vp-app) を build して GitHub Release に artifact を upload"
#
# file-based mise task 移行 (2026-05-30)。 旧 [tasks."push:mac"] を Ruby file task に移植。
# version (workspace.package.version) → cargo build release → tar.gz archive → gh release upload。
require "fileutils"
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

# version は workspace.package.version (release: vX.Y.Z タグ形式)。
version = File.read("Cargo.toml")[/^version = "([^"]+)"/, 1] or VP.die("version が Cargo.toml に見つかりません")
tag = "v#{version}"
VP.log "push:mac for #{tag}"

VP.sh "cargo build --release --target aarch64-apple-darwin -p vp-cli -p vp-app"

rel = "target/aarch64-apple-darwin/release"
VP.need_exec(File.join(rel, "vp"),     hint: "build 失敗?")
VP.need_exec(File.join(rel, "vp-app"), hint: "build 失敗?")

dist = "target/dist"
FileUtils.mkdir_p(dist)
archive = File.join(dist, "vp-#{version}-aarch64-apple-darwin.tar.gz")
VP.log "archive: #{archive}"
VP.sh "tar czf '#{archive}' -C '#{rel}' vp vp-app"
VP.sh "ls -lh '#{archive}'"

# 既存 release があれば --clobber で同名 asset 上書き、 無ければ create。
if system("gh", "release", "view", tag, out: File::NULL, err: File::NULL)
  VP.log "upload to existing release #{tag} (--clobber)"
  VP.sh "gh release upload '#{tag}' '#{archive}' --clobber"
else
  VP.log "create release #{tag} with first asset"
  VP.sh "gh release create '#{tag}' '#{archive}' --title '#{tag}' --generate-notes --latest"
end

VP.log "#{VP.icon(:ok)} pushed: #{archive} → release #{tag}"
