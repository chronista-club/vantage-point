# Rust
/target/

# Node — bundle 各所の依存（web-bundle / sidebar-bundle 等）。 どの階層でも除外
node_modules/

# Xcode
.build/
.swiftpm/
*.xcodeproj/
*.xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store
*.app
*.app.zip

# 移行中のファイル（ルートディレクトリのみ）
/ClaudeTestApp/

# Working directory (for temporary files and experiments)
/working/

# Git worktrees
/.worktrees/

# Personal notes (not tracked in git)
/.notes/

# Serena memories (per-user, not tracked)
.serena/
.env

# Local settings (per-user, not tracked)
*.local.*
.claude/worktrees/
.claude/scheduled_tasks.lock
.gitnexus

# xcodebuild 中間成果物
/apple/VantagePoint/build/

# Release 配布物（DMG 等）
/dist/


# MCP servers — per-developer 管理 (CC は .mcp.local.json overlay 未対応のため、
# .mcp.json 自体を gitignore して各自で auth state を持つ。 共有 baseline が
# 必要になった時点で minimal subset の commit を再検討)
.mcp.json

# dev / build / debug log 全般 (mise win task の stderr redirect 先、
# cargo build/test の tee 先、 daemon/SP の foreground redirect 等)。 全て per-run の
# 一時成果物なので tracking しない。
*.log
history.txt

# Vantage Point lane workspaces (project-local lane refactor)
.vp/

# JetBrains IDE 設定 (per-developer、 commit 対象外)
.idea/
rust_out
