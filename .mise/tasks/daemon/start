#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="TheWorld daemon を background spawn (nohup detach、 task は即 exit、 log は logs task で tail)"
#
# file-based mise task 移行 (2026-05-30、 daemon group)。 旧 [tasks."daemon:start"] を Ruby に移植。
# bash の `nohup "$VP" daemon start </dev/null >>log 2>&1 & disown` (controlling tty / parent process
# group から切離して spawn) を Process.spawn(pgroup: true, redirect to log) + Process.detach で表現。
# task は spawn 後すぐ exit (旧: foreground blocking で log tail まで持っていたのを 2026-05-07 に detach 化)。
#
# 既存 daemon が居る場合は事前に `mise run daemon:stop`、 または `vp daemon stop && mise run daemon:start`。
# restart は CLI に持たない方針 (user 指示「restart いらない、 build -> start -> stop が cli で回ってから」)。
require "fileutils"
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

FileUtils.mkdir_p(VP.log_dir)
daemon_log = File.join(VP.log_dir, "daemon.kdl.log")  # tracing 経由 KDL (structured)
stdout_log = File.join(VP.log_dir, "daemon.stdout.log") # stdout/stderr (panic 等の chaotic 出力)
FileUtils.touch([daemon_log, stdout_log])

vp = VP.cargo_bin("vp")
VP.need_exec(vp, hint: "先に `mise run cli:build`")

# structured log の出力先を子に継承させる (= bash の export VP_DAEMON_LOG_FILE)。
ENV["VP_DAEMON_LOG_FILE"] = daemon_log
VP.log "daemon log: #{daemon_log}"
VP.log "daemon stdout: #{stdout_log}"
VP.log "Spawning daemon (detach、 task 即 exit)…"

# nohup + & + disown 相当: 新 process group + stdin /dev/null + stdout/err を log に追記。
pid = Process.spawn(vp, "daemon", "start",
                    pgroup: true, in: File::NULL,
                    out: [stdout_log, "a"], err: %i[child out])
Process.detach(pid) # zombie 回収 (= shell job table から外す disown 相当)
VP.log "✅ daemon spawned (PID=#{pid})"
VP.log "tail: mise run logs"
