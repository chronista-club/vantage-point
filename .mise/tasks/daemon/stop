#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="TheWorld daemon + 裏で動く SP プロセスを一括停止 (旧 nuke 相当)"
#
# 2026-05-30 daemon→world 改名。 cascade teardown (World + SP) を担う world group の一員。
# 2-phase cascade kill: [1/2] SP プロセス (TERM→KILL、 PtySlot Drop で lane claude も落ちる) → [2/2] daemon stop。
# tmux decoupling PR2: 旧 [2/3] tmux session kill phase は退役 (lane は SP の子 = SP kill で完全停止)。
# 移行 note: 旧 binary 世代の orphan tmux session が残っている場合は `tmux -L vp kill-server` で手動掃除。
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

vp = VP.cargo_bin("vp")

# pgrep -f 'vp sp start' の PID 群 (= SP プロセス、 daemon:reset:sp と同ロジック)。
def sp_pids = `pgrep -f 'vp sp start'`.split.map(&:to_i)
# 個別 signal (既に消えた PID の ESRCH は握り潰す = bash の `|| true`)。
def signal_all(sig, pids) = pids.each { Process.kill(sig, it) rescue nil }

VP.log "#{VP.icon(:bomb)} Vantage Point daemon + 関連プロセス停止 (cascade kill)…"

# ── [1/3] SP プロセスを kill ──────────────────────────────────────────────
warn "#{VP.icon(:sync)} [1/2] 全 SP プロセス検出…"
pids = sp_pids
if pids.empty?
  warn "   #{VP.icon(:info)} 実行中の SP プロセスはありません"
else
  warn "   #{VP.icon(:note)} 検出した SP: #{pids.join(' ')}"
  system("ps", "-p", pids.join(","), "-o", "pid,etime,start,command")
  warn "   #{VP.icon(:stop)} SIGTERM 送信 (graceful → PtySlot Drop = child claude も kill)…"
  signal_all("TERM", pids)
  sleep 2
  remaining = sp_pids
  unless remaining.empty?
    warn "   #{VP.icon(:warn)} 残存に SIGKILL: #{remaining.join(' ')}"
    signal_all("KILL", remaining)
    sleep 1
  end
  warn "   #{VP.icon(:ok)} SP kill 完了"
end

# ── [2/2] TheWorld daemon を停止 ──────────────────────────────────────────
warn "#{VP.icon(:sync)} [2/2] TheWorld daemon 停止…"
if File.executable?(vp)
  if system(vp, "daemon", "stop", out: File::NULL, err: File::NULL)
    warn "   #{VP.icon(:ok)} daemon stop 完了"
  else
    warn "   #{VP.icon(:info)} daemon は既に停止しているか、 reach 不能"
  end
else
  warn "   #{VP.icon(:warn)} vp binary 不在 (#{vp}) — daemon stop スキップ"
  warn "      build 済なら `mise run daemon:build` 後に再実行してください"
end

VP.log "#{VP.icon(:ok)} daemon + 関連プロセス停止完了。 再起動: mise run app"
