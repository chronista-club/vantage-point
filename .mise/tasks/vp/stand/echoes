#!/usr/bin/env bash
#MISE description="VP Stand: Echoes — Claude TUI auto-launch with tmux 副舞台 (Tier 2)"
# PR-pre2 (VP-118): Heaven's Door 📖 → Echoes 💬 rename。 zsh → tmux → claude の
# chain spawn が Echoes Act 1/2/3 進化と完璧 fit、 terminal echo 構造とも literal に一致。
# VP env (caller が設定):
#   VP_CWD     = Lane の working directory (tmux session の cwd に使う)
#   VP_SESSION = tmux session 名
#   VP_PROJECT = project 名
#   VP_LANE    = lane label
#   VP_FRESH   = "1" で resume/continue を回避し fresh な claude を起動 (optional、 "New Conductor Session")
# VP-specific metadata:
#VP icon="💬"
#VP tier=2

set -euo pipefail

# UTF-8 ロケール保証 (CJK 化け `_` の根治):
#   tmux は client (= この exec tmux プロセス) の LC_CTYPE/LANG/LC_ALL で UTF-8 mode を判定する。
#   launchd 起動の daemon は LANG を持たず、 daemon → SP → mise → tmux と C ロケールが伝播するため
#   tmux client が utf8=0 になり、 内部 grid (UTF-8) は正しいのに **outer client へ描画する時** CJK /
#   fullwidth を `_` に潰して xterm.js へ送る (fullwidth=2 列=`_`×2)。 既存 LANG は尊重し、 未設定時のみ
#   UTF-8 を補う (= utf8=1 化)。 inner shell/claude は -l で .zshrc の locale をさらに上書きできる。
: "${LANG:=en_US.UTF-8}"
export LANG
: "${LC_CTYPE:=$LANG}"
export LC_CTYPE

# VP_PROFILE 分離: dev binary (VP_PROFILE=dev) と brew cask の tmux server を別 socket に隔離する。
#   未設定 (brew) = 素の "vp" / dev = "vp-dev"。 Rust 側 tmux_socket() (= app_dir_name()) と一致。
#   別 socket = 別 server なので session 名・adopt は profile 間で衝突しない (2026-07-01 混線の根治)。
#   VP_PROFILE は SP の env から build_stand_command 経由で明示注入される (継承非依存)。
SOCK="vp${VP_PROFILE:+-$VP_PROFILE}"

# tmux server config (xterm.js 描画相性、 PR #243)
tmux -L "$SOCK" start-server 2>/dev/null || true
tmux -L "$SOCK" set-option -g focus-events on 2>/dev/null || true
tmux -L "$SOCK" set-option -g escape-time 0 2>/dev/null || true
tmux -L "$SOCK" set-option -ga terminal-overrides ',xterm-256color:Tc' 2>/dev/null || true
# cc 通知 (OSC 99 / kitty desktop notification) を outer (vp-app xterm.js) へ透過する。
# tmux は既定で OSC 99 を握り潰すため、 これが無いと Lane sidebar の awaiting_input dot が
# 出ない。 VP が自前 set することで user の ~/.tmux.conf に依存せず箱から通知が出る
# (公式: https://code.claude.com/docs/en/terminal-config#configure-tmux)。
tmux -L "$SOCK" set-option -g allow-passthrough on 2>/dev/null || true
# tmux 下で Shift+Enter を newline 識別 (cc multiline)。
tmux -L "$SOCK" set-option -s extended-keys on 2>/dev/null || true
tmux -L "$SOCK" set-option -as terminal-features 'xterm*:extkeys' 2>/dev/null || true

# tmux 副舞台 + claude auto-launch + 終了後 shell fallback:
#
#   tmux command:
#     '$CLAUDE_CMD; exec $SHELL -l'
#       1. $CLAUDE_CMD で claude を起動 (下記の conductor/performer 分岐)
#       2. claude 終了後 (e.g. /exit) は exec で login shell に切替えて tmux session 内に
#          bash/zsh prompt を維持 ─ user は `claude -c` で復帰 / `zsh` 別起動 / `exit` で
#          明示終了 等を自由に選べる (旧 LlmStand 経路の outer shell 体験を tmux session 内に
#          閉じ込めた形、 PR-B 移行で消えた tier の代替実装)。
#
#   外側 || fallback (tmux 不在環境):
#     cd "$VP_CWD" && eval "$CLAUDE_CMD"
#     ─ shell 上で素 claude を起動。 doc 11 PR-D (Z 系統) で spawn cwd は VP install
#       root なので、 明示的に project dir に cd してから claude を起動する。
LOGIN_SHELL="${SHELL:-/bin/zsh}"

# wiremsg R2-c (チャネル B、 決定 D2): wire 未読通知 hook を VP が spawn 時に注入する。
# dotfile 非依存で箱から動く (#512/#515 と同じ「VP が自前担保」哲学)。 hook 実体は
# `vp wire hook-check` (vp CLI 同梱、 配布物不要)。 UserPromptSubmit で未読 wire を
# additionalContext 通知し、 daemon 不在・エラー時は silent 成功 (fail-open、 会話を邪魔しない)。
# JSON に single quote が無いため '$WIRE_HOOKS' 埋め込みで安全に quote できる
# (tmux 内 shell の word splitting 防止)。
#
# NOTE: SessionStart (session_id 記録、 R3-b) は inline ではなく global settings
# (~/.claude/settings.json) の hook に移管した。 inline だと echoes が spawn した session
# しか記録できず、 user が /exit → 素のターミナルで fresh `claude` を起動した session の id を
# 取りこぼす (= 旧 id に固定され続ける)。 global に置けば手動起動も SessionStart で拾える。
# 二重発火 (inline + global) を避けるため SessionStart は inline から外してある。
# 依存: この feature は global hook が入っているマシンでのみ動く (new-machine-setup 参照)。
WIRE_HOOKS='{"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":"vp wire hook-check"}]}]}}'

# CC 2.1 Background Agents insulate (Phase B):
# `claude --continue` は CC 2.1.156+ で background session が存在すると単一 REPL でなく
# Agent View dashboard (multi-session manager) を開き、 VP の send-keys handoff が
# list-nav UI に化けて詰まる。 機械が send-keys で操る performer (wing) は fresh `claude`
# で deterministic に clean REPL を保証する (wire handoff は永続なので起動後 wire_recv で
# 拾える)。 user が対話する conductor は session 永続化 (= VP コアコンセプト) を優先して
# `--continue` chain を維持 (dashboard が出ても人間は操作できる)。
# 関連 memory: mem_1CbXZyCiqrdgteGhRFDaHW (CC 2.1 Background Agents daemon × VP)
if [ "${VP_FRESH:-}" = "1" ]; then
    # sidebar "New Conductor Session" (lane:restart fresh=true): resume/continue を回避して
    # 必ず fresh な claude を起動する。 一度 /exit → 素の `claude` を打ち直す手間を menu 1 click に
    # 畳む。 新 session の id は global SessionStart hook (vp wire hook-check) が cc_session file に
    # 記録するので、 以後の通常 restart はこの fresh session を --resume で継ぐ (= 非破壊、 旧会話も
    # claude 履歴に残り /resume で復元可能)。
    CLAUDE_CMD="claude --settings '$WIRE_HOOKS'"
elif [ "${VP_LANE:-}" = "conductor" ]; then
    # wiremsg R3-b: 前回 session を指名 resume する (CC 2.1 の Agent View dashboard 罠の
    # 構造的回避 — `--continue` は「cwd の最新」を拾うため bg session 在りで dashboard 化する。
    # 設計 mem_1CbXZyCiqrdgteGhRFDaHW)。 id は SessionStart hook (vp wire hook-check、 global
    # settings) が記録した lane 単位の保存値 (`vp lane last-session` が VP_PROJECT/VP_LANE から読む)。
    # 未記録 (初回 / 移行直後) は従来の --continue chain を維持 — 一度 session が立てば
    # hook が記録し、 以後この分岐は --resume 側に乗る。 resume 失敗 (session 消失) は
    # fresh claude に fallback。 id は英数+ハイフンのみ (last-session 側で検証済) のため
    # single quote 埋め込みは安全。
    RESUME_ID="$(vp lane last-session 2>/dev/null || true)"
    if [ -n "$RESUME_ID" ]; then
        CLAUDE_CMD="claude --resume '$RESUME_ID' --settings '$WIRE_HOOKS' || claude --settings '$WIRE_HOOKS'"
    else
        CLAUDE_CMD="claude --continue --settings '$WIRE_HOOKS' || claude --settings '$WIRE_HOOKS'"
    fi
else
    CLAUDE_CMD="claude --settings '$WIRE_HOOKS'"
fi
# -x 120 -y 48: session の初期サイズ。 client 未 attach (headless) でも極小
# (9×3) に張り付かず claude が実用サイズで動く。 vp-app で表示すると attach
# client サイズへ resize される (tmux window-size latest)。 新規 session のみ
# 有効で、 -A で既存 session に attach する場合は無視される。
#
# -e VP_*: per-session 環境変数を明示注入する (cross-project identity leak の根治)。
# VP は 1 profile 内の全 lane を 1 つの tmux server (socket=$SOCK) で動かすため、 最初に server を
# 起動した lane の VP_* が tmux の GLOBAL 環境に焼き付く。 -e を付けないと後続の全 lane
# が「最初の lane」の VP_PROJECT / VP_SESSION / VP_CWD を継承し、 別 project の identity
# で claude が動いてしまう。 -e で session 固有 env を global に優先させ、 各 lane の
# claude が自分の正しい identity (wire addressing / statusline 等が依存) を見るようにする。
# Act 2(tmux) → Act 3(claude)。 tmux を **exec しない** のが要点。 exec だと「tmux client の attach
# が実行時に失敗 (TERM 不在 → open terminal failed / socket・session race 等)」した時に process が
# 既に tmux に置換されており、 tmux が非ゼロ終了しても下の fallback に到達できず lane が silent
# Dead 化したまま (「なぜ落ちたか」が Echoes に出ない)。 非 exec にして終了コードで判定する。
# (注: inner pane の CLAUDE_CMD が死んでも tmux client 自体は exit 0 なので、 ここで捕捉できるのは
#  tmux client の attach 失敗のみ。 claude の起動失敗は下の「直起動 claude」fallback 側で顕在化する。)
# fallback を通すため以降は errexit を解除する。
set +e
tmux -L "$SOCK" new-session -A -x 120 -y 48 -c "$VP_CWD" -s "$VP_SESSION" \
    -e "VP_CWD=$VP_CWD" -e "VP_PROJECT=$VP_PROJECT" \
    -e "VP_SESSION=$VP_SESSION" -e "VP_LANE=$VP_LANE" \
    -e "VP_PROFILE=${VP_PROFILE:-}" \
    "$CLAUDE_CMD; exec $LOGIN_SHELL -l"
tmux_rc=$?
# tmux 正常終了 (detach / exit 0) = lane を通常どおり終える (従来挙動、 fallback しない)。
# 非ゼロ = Act 2 起動失敗のみ fallback: 素 claude 直起動 (doc 11 PR-D: install root cwd から
# project へ cd)、 それも戻ったら最終的に Act 1 login shell を PTY に残す。 失敗理由 (tmux attach /
# 直起動 claude の error 出力) を Act 1 コンソールに生かしたまま user が回復操作 (手打ち
# tmux→claude 等) を打てるようにする ─ Echoes は Act 1 から出力を受け取り続ける。
if [ "$tmux_rc" -ne 0 ]; then
    cd "$VP_CWD" && eval "$CLAUDE_CMD"
    exec "$LOGIN_SHELL" -l
fi
