#!/usr/bin/env ruby
# frozen_string_literal: true
#MISE description="Mac app を notarized .dmg として build→codesign→notarize→GitHub Release に publish (Phase B)"
#
# Phase B (2026-05-30): 旧 push:mac (tar.gz upload) を full release pipeline に格上げ。
# 配布動線: portal DL → .dmg マウントしてコピー / `brew install --cask vantage-point` (どちらも
# notarized .dmg が source。 App Store は CC 依存で sandbox 不可のため使わない)。
#
# pipeline: build → .app 組立 → codesign(Developer ID, hardened runtime) → .dmg(hdiutil)
#           → notarize → staple → gh Release publish → cask 用 sha256 出力。
#
# 前提 (gate):
#   - Developer ID Application cert (keychain) … "Anycreative Inc. (3EQKG4B352)" — 確認済
#   - notarytool keychain profile "vp-notary" (App Store Connect API key 推奨):
#       xcrun notarytool store-credentials vp-notary --key <AuthKey.p8> --key-id <KEY_ID> --issuer <ISSUER_ID>
#       (ASC API key: https://appstoreconnect.apple.com/access/integrations/api)
#   - icon: crates/vp-app/assets/icon.icns (portal favicon 由来、 自動 embed)
#
# VP_RELEASE_DRY=1 で notarize + publish を skip (build/sign/dmg だけ local 検証、 creds 不要)。
require "fileutils"
require "digest"
require File.join(ENV.fetch("MISE_PROJECT_ROOT"), "scripts/mise/vp.rb")

APP        = "Vantage Point"
APP_BUNDLE = "VantagePoint.app"
BUNDLE_ID  = "tech.anycreative.vp"
TARGET     = "aarch64-apple-darwin"
SIGN_ID    = "Developer ID Application: Anycreative Inc. (3EQKG4B352)"
NOTARY     = "vp-notary"
MIN_MACOS  = "11.0"
DRY        = ENV["VP_RELEASE_DRY"] == "1"          # build/sign/dmg だけ (notarize/publish skip)
NO_PUBLISH = ENV["VP_RELEASE_NO_PUBLISH"] == "1"   # notarize+staple まで (gh publish だけ skip)

version = File.read("Cargo.toml")[/^version = "([^"]+)"/, 1] or VP.die("version が Cargo.toml に見つかりません")
tag = "v#{version}"
VP.log "#{VP.icon(:rocket)} release:mac #{tag}#{DRY ? '  (DRY: notarize/publish skip)' : ''}"

# ── 0. cert 前提チェック ────────────────────────────────────────
`security find-identity -v -p codesigning 2>/dev/null`.include?(SIGN_ID) or
  VP.die("Developer ID cert 不在: #{SIGN_ID}\n  keychain に Anycreative の Developer ID Application 証明書を import してください")

# ── 1. build (release, arm64) ──────────────────────────────────
# VP_RELEASE_SKIP_BUILD=1 で既存 binary を使い build を skip (CI / メモリ逼迫時の検証用)。
if ENV["VP_RELEASE_SKIP_BUILD"] == "1"
  VP.log "#{VP.icon(:info)} VP_RELEASE_SKIP_BUILD=1 — cargo build を skip (既存 binary 前提)"
else
  # webview bundle は gitignore の生成物 (2026-07-19 に commit 運用を廃止)。 cargo build の
  # 前段で毎回生成する — app:swap も本 task の DRY 経路を共有するので、 dogfood と release の
  # bundle が同じ手順で作られる (stale bundle が ship される footgun の根治)。
  VP.sh "mise run app:bundle"
  VP.sh "cargo build --release --target #{TARGET} -p vp-app -p vp-cli"
end
rel = "target/#{TARGET}/release"
VP.need_exec(File.join(rel, "vp-app"), hint: "build 失敗?")
VP.need_exec(File.join(rel, "vp"),     hint: "build 失敗?")

# ── 2. .app 組立 ───────────────────────────────────────────────
dist  = "target/dist"
app   = File.join(dist, APP_BUNDLE)
macos = File.join(app, "Contents", "MacOS")
res   = File.join(app, "Contents", "Resources")
FileUtils.rm_rf(app)
FileUtils.mkdir_p([macos, res])
# vp-app = 主 executable、 vp = daemon を同梱 (vp-app が spawn する)。
#   ※ vp-app の vp 探索が bundle 内 (Contents/MacOS/vp) を見るかは app 側 follow-up。
FileUtils.cp(File.join(rel, "vp-app"), File.join(macos, "vp-app"))
FileUtils.cp(File.join(rel, "vp"),     File.join(macos, "vp"))

# tmux decoupling PR2 (v0.29.0): 旧「stand init_script (.mise/tasks/vp/stand) を .app に bundle」
# は退役。 stand spawn は Rust-native (`stand_spawner::build_stand_command` が login shell + claude
# を直接組む) になり、 script 層 / install_root 解決 / mise が product から消えたため、 end-user の
# .app に同梱する script は無い (床 shell + claude さえ在れば lane が立つ)。

icon_src = "crates/vp-app/assets/icon.icns"
has_icon = File.exist?(icon_src)
FileUtils.cp(icon_src, File.join(res, "icon.icns")) if has_icon
VP.log "#{VP.icon(:warn)} icon 不在 (#{icon_src}) — generic で続行" unless has_icon

File.write(File.join(app, "Contents", "Info.plist"), <<~PLIST)
  <?xml version="1.0" encoding="UTF-8"?>
  <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
  <plist version="1.0"><dict>
    <key>CFBundleName</key><string>#{APP}</string>
    <key>CFBundleDisplayName</key><string>#{APP}</string>
    <key>CFBundleIdentifier</key><string>#{BUNDLE_ID}</string>
    <key>CFBundleExecutable</key><string>vp-app</string>
    <key>CFBundleVersion</key><string>#{version}</string>
    <key>CFBundleShortVersionString</key><string>#{version}</string>
    <key>CFBundlePackageType</key><string>APPL</string>#{has_icon ? "\n    <key>CFBundleIconFile</key><string>icon</string>" : ""}
    <key>LSMinimumSystemVersion</key><string>#{MIN_MACOS}</string>
    <key>NSHighResolutionCapable</key><true/>
  </dict></plist>
PLIST
VP.log "#{VP.icon(:build)} assembled #{app}"

# ── 3. codesign (hardened runtime, inside-out) ─────────────────
# entitlements: WKWebView(wry) の JIT + 子プロセス spawn 用。 notarize は許容、 必要に応じ tighten。
ent = File.join(dist, "vp.entitlements")
File.write(ent, <<~ENT)
  <?xml version="1.0" encoding="UTF-8"?>
  <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
  <plist version="1.0"><dict>
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
  </dict></plist>
ENT
sign = ->(path) { VP.sh "codesign --force --options runtime --timestamp --entitlements '#{ent}' -s '#{SIGN_ID}' '#{path}'" }
sign.call(File.join(macos, "vp")) # 同梱 binary を先に (inside-out)
sign.call(app)                    # bundle (主 executable vp-app を sign + seal)
VP.sh "codesign --verify --deep --strict --verbose=2 '#{app}'"
VP.log "#{VP.icon(:ok)} signed & verified"

# ── 4. .dmg (hdiutil、 /Applications symlink で drag-install UX) ─
stage = File.join(dist, "dmg-staging")
FileUtils.rm_rf(stage); FileUtils.mkdir_p(stage)
FileUtils.cp_r(app, File.join(stage, APP_BUNDLE))
File.symlink("/Applications", File.join(stage, "Applications")) rescue nil
dmg = File.join(dist, "VantagePoint-#{version}-arm64.dmg")
FileUtils.rm_f(dmg)
# hdiutil の auto-size は content ぴったりで HFS overhead 分溢れる (No space) ので size を明示。
# ×2+50 だと staging 101MB (vp 85MB + vp-app 19MB) で 252m となり、 hdiutil が
# 「image data corrupted」で間欠的に失敗した (v0.33.0、 512m で実証成功)。 大きな単一 binary で
# HFS+ intermediate が想定以上を要するため、 倍率と floor を引き上げて余裕を確保する。
# UDZO 圧縮されるので最終 dmg 自体は膨らまない (256m でも最終 ~45MB)。
stage_mb = `du -sm '#{stage}'`.to_i
dmg_size = [stage_mb * 4 + 100, 512].max
VP.sh "hdiutil create -size #{dmg_size}m -volname '#{APP}' -srcfolder '#{stage}' -ov -format UDZO '#{dmg}'"
VP.sh "codesign --force --timestamp -s '#{SIGN_ID}' '#{dmg}'"
VP.log "#{VP.icon(:ok)} dmg: #{dmg}"

if DRY
  VP.log "#{VP.icon(:info)} DRY 完了 — local signed dmg = #{dmg} (notarize/publish skip)"
  exit 0
end

# ── 5. notarize + staple ───────────────────────────────────────
VP.log "#{VP.icon(:sync)} notarize 中 (profile=#{NOTARY}、 Apple 往復で数分)…"
system("xcrun", "notarytool", "submit", dmg, "--keychain-profile", NOTARY, "--wait") or
  VP.die("notarize 失敗。 profile '#{NOTARY}' 未登録なら:\n" \
         "  xcrun notarytool store-credentials #{NOTARY} --key <AuthKey.p8> --key-id <KEY_ID> --issuer <ISSUER_ID>\n" \
         "  (ASC API key: https://appstoreconnect.apple.com/access/integrations/api)")
VP.sh "xcrun stapler staple '#{dmg}'"
VP.sh "spctl -a -t open --context context:primary-signature -vvv '#{dmg}'"
VP.log "#{VP.icon(:ok)} notarized & stapled"

if NO_PUBLISH
  sha = Digest::SHA256.file(dmg).hexdigest
  VP.log "#{VP.icon(:info)} VP_RELEASE_NO_PUBLISH=1 — gh publish skip。 notarized dmg = #{dmg}"
  warn "  sha256: #{sha}"
  exit 0
end

# ── 6. GitHub Release publish (portal DL / cask の source) ──────
if system("gh", "release", "view", tag, out: File::NULL, err: File::NULL)
  VP.sh "gh release upload '#{tag}' '#{dmg}' --clobber"
else
  VP.sh "gh release create '#{tag}' '#{dmg}' --title '#{tag}' --generate-notes --latest"
end

VP.log "#{VP.icon(:ok)} published: #{File.basename(dmg)} → release #{tag}"

# ── 7. Homebrew cask を自動更新 (best-effort) ──
# release:cask が local の target/dist/<dmg> から sha256 を算出して tap (chronista-club/
# homebrew-tap) の Casks/vantage-point.rb を push。 失敗しても release 自体は成功扱い
# (手動 `mise run release:cask` で再試行可)。
VP.log "#{VP.icon(:sync)} cask 更新 (release:cask)…"
unless system("mise", "run", "release:cask")
  VP.log "#{VP.icon(:warn)} cask 更新失敗 — `mise run release:cask` で手動再試行してください"
end
