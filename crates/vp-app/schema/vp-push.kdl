// vp-app server → webview push protocol schema — SSOT
//
// Rust（vp-app）が main webview に押し込む message を、この KDL を唯一の真実として
// club-kdl-codegen で生成する:
//
//   - Rust enum → crates/vp-app/src/generated/push.rs            (`PushEnvelope`)
//   - TS union  → crates/vp-app/webview/src/generated/Push.ts    (`PushEnvelope`)
//
// 生成は `cargo test -p vp-app --test push_codegen` で走る（tests/push_codegen.rs）。
//
// ## なぜ envelope 1 本にするか（doc 53 §6.5 の続き）
//
// 旧来 Rust → JS は **名前で関数を呼ぶ**形だった（`evaluate_script("window.ensureLane(...)")`、
// 面は ~24 個 / 呼び出し 40 箇所）。この形には 2 つの負債がある:
//
// 1. **型が無い** — 引数の数や順序が食い違っても Rust も TS も黙る。#921 で HTML 文字列に対する
//    assert を撤去したぶん、いま完全に無防備
// 2. **押し込みが黙って落ちる** — `window.X && window.X.y(...)` は bundle 準備前なら **no-op で
//    成功**する。VP はこの穴を feature ごとの pull で埋めてきた（`lanes:ensure-all` /
//    `bastet:devices_fetch` / `board:demand` の 3 本 + 退役 1 本 `echoes:sessions_fetch`）
//
// envelope 1 本 + 受け側の buffer にすると、②が**構造的に**消える（準備前の push は queue に
// 積まれ ready で流れる）ので、上の catch-up pull は順次退役できる。①は codegen が塞ぐ。
//
// ## 移行方針（strangler）
//
// 骨格（この schema + dispatcher）を先に入れ、~24 面は **1 つずつ** envelope へ移す。
// 一度に全部移すと、回帰が出たとき原因を「移設」と「envelope 化」のどちらにも帰せなくなる
// （#921 で「純粋な移設」に絞った判断と同じ理由）。
//
// ## 何を buffer するか
//
// **制御面（この channel）は buffer する** — 取りこぼすと state が食い違うため。
// 一方 **stream 面（PTY 出力 `vpTerminal.handleOutput` 等）は buffer しない**方針で、
// これは別 event として足すときに改めて決める（server 側 replay が取りこぼしを埋めるので、
// 積むとメモリだけ食う）。現時点の第 1 弾は制御面のみ。

protocol "vp-push" version="1.0.0" {
    namespace "vp.push"

    // channel "push": envelope="t" で全 push を束ねる discriminated union（`PushEnvelope`）。
    // from="server" = Rust 側が開いて押し込む向き。lifetime="persistent" = webview の生存中ずっと。
    channel "push" from="server" lifetime="persistent" envelope="t" {
        // ===== Conversation tui（xterm）の制御面 — 実装は webview/term.ts =====

        // (lane, session) の xterm instance を用意する（既存なら no-op = 冪等）。
        // `is_root` は **host の選び方には使わない**（host の身元は session）。focus の優先だけ。
        // root は付け替えで動くので、既存 instance にも毎回焼き直す。
        event "term:ensure_lane" {
            field "lane" type="string"
            field "session" type="int"
            field "is_root" type="bool"
        }

        // 表示する lane を切り替える。`lane` 省略 = どの lane も選ばれていない（placeholder）。
        // `is_chat` = gui（xterm を持たないのが正常形）— placeholder の抑止に要る。
        event "term:show_lane" {
            field "lane" type="string" optional=#true
            field "is_chat" type="bool"
        }

        // lane 消滅: その lane の **全 session** の xterm を畳む。
        event "term:remove_lane" {
            field "lane" type="string"
        }

        // session 1 枚だけ畳む（mode 切替 tui→chat の後始末）。
        event "term:remove_session" {
            field "lane" type="string"
            field "session" type="int"
        }

        // OS clipboard の中身を focus 中の xterm へ流し込む（`paste:request` の戻り）。
        event "term:paste" {
            field "text" type="string"
        }

        // ===== 計器盤（device 一覧, doc 52 §4）の制御面 — 実装は webview/devices.ts =====
        //
        // wire 名は **機能名**（`devices:`）— 表示層の語をコード識別子に出さない規約
        // （memory `naming-stand-vs-code`）。旧 `vpBastet` / `bastet.ts` / `pane-bastet` は
        // この規約への歴史的な違反だったが、rename(devices)（2026-07-27）で解消済み。

        // MIDI device 一覧を pane に render する（差分でなく**全量の置き換え** = level 駆動）。
        // 要素の形の持ち主は Rust `pane::DeviceSnapshot` / TS 側 `devices.ts` の `DeviceInfo`。
        // ここで `array<json>` にしているのは、その 1 つの形を **KDL にも書くと二重定義**に
        // なるため（wire 上は今までと同じ `serde_json::to_string(devices)`）。
        event "devices:render" {
            field "devices" type="array<json>"
        }

        // ===== Conversation の Console 面（doc 33）— 実装は webview/console.ts =====

        // lane の session 一覧（roster）。**供給はこの 1 本**（doc 53 §11）で、呼び手は
        // LanesLoaded の 1 箇所だけ。payload の形の持ち主は TS の `ConversationSessionListPayload`
        // （Rust 側は `session_list_payload()` が組む）。
        event "console:session_list" {
            field "lane" type="string"
            field "payload" type="json"
        }

        // repo の ClaudeHost が吐く構造化イベント（gui の会話 stream）。
        //
        // ⚠️ これは**制御面ではなく stream**。取りこぼしは受け側の replay 要求
        // （`conversation:demand_start`）が埋めるので、**この channel の保留箱に頼らない**。
        // 同じ channel に載せているのは窓口を増やさないため（保留窓は openDispatch →
        // installDispatch の間だけなので、stream が積み上がる余地は事実上ない）。
        event "console:event" {
            field "lane" type="string"
            field "event" type="json"
            // VP 採番の session key。console.ts が focused 判定に使い、chatview が背景 session の
            // stream を焦点会話へ混ぜないよう振り分ける。
            field "session" type="int"
        }

        // mode 切替が **実体に適用された**通知（`SessionModeApplied` の戻り）。
        // 要求側の IPC tag `session:set_mode`（JS → Rust）と対で、こちらは applied の報せ。
        event "console:mode_applied" {
            field "lane" type="string"
            field "session" type="int"
            field "mode" type="string"
        }

        // 「+」menu の agent 一覧（`agents_list` の結果）。
        // `req` = 要求元の相関 id（doc 47 §6）。共有 bus の購読側がこれで振り分ける。
        // 省略 = 応答を誰も拾わない（旧: JS へ `null` 直書き）。
        event "console:agents" {
            field "lane" type="string"
            field "payload" type="json"
            field "req" type="string" optional=#true
        }

        // ===== 対話面（ink, doc 52 §3）の制御面 — 実装は webview/ink.ts =====
        //
        // board pane に描いた注釈を PNG 化する往復の**戻り**。要求（`ink:snapshot` IPC）は
        // client → server で、こちらはその応答にあたる。成功と失敗で受け手の振る舞いが
        // 別（成功 = 会話へ送る / 失敗 = 注釈を残して再送可能にする）なので **2 event に分ける**
        // — 1 event に `path` / `error` を両方 optional で載せると「どちらでもない」が型に載る。

        // snapshot 成功: PNG の絶対 path。
        event "ink:snapshot" {
            field "path" type="string"
        }

        // snapshot 失敗: 理由（toast に出す）。
        event "ink:snapshot_error" {
            field "message" type="string"
        }

        // ===== 掲示板（board, doc 52 §1）の制御面 — 実装は webview/board-handler.ts =====

        // repo の canvas channel から来た `RepoMessage` をそのまま board へ渡す。
        // **中身は VP が定義していない**（repo が持つ形の転送）ので `json` 1 枚が正直な型。
        // 型が要るのは「どの窓口に届けるか」であって、ここでは payload の中身ではない。
        event "board:message" {
            field "message" type="json"
        }
    }
}
