// vp-daemon channel の wire protocol を記述する KDL（runtime discovery 用）。
//
// 目的:
//   VP daemon（daemon、Unison ProtocolServer "vp-daemon"）が起動時に enable_discovery で
//   この KDL を unison.discovery channel から配信する。無改造の unison-mcp（Unison Protocol の
//   runtime discovery + typed tool 合成 MCP bridge、v1.1.0+）が runtime fetch して
//   `unison_<channel>_<method>` の typed tool を合成できるようにする。VP 開発のデバッグ機。
//
// 位置づけ（重要 — schema/vp-agent.kdl とは別物）:
//   vp-agent.kdl = agent action space の SSOT（build-time codegen でキュレーション済み MCP tool を
//   生成）。vp-daemon.kdl = 「daemon channel の wire protocol の記述的スキーマ」。現行のキュレー
//   ション済み MCP を置き換えない（別プロセス・別 tool namespace の dev/dogfood 面）。
//   設計判断: docs/design/27-apple-surface-lifecycle.md §5、handoff mem_1Ccu5RK4VMT7xjaMxm9JXM。
//
// 制約（drift 防止）:
//   - request 名 = wire の msg.method と文字列一致必須（記述的スキーマ。リネーム = 既存 client 破壊）。
//     SSOT: crates/vantage-point/src/daemon/server.rs の各 channel handler の `match method`。
//   - channel 名 ⊆ daemon が register_channel する集合。drift 検出は tests/vp_daemon_kdl.rs。
//   - request の description / field の description は synthesized tool の description に昇格する
//     （unison-mcp mapping.rs、formulaic を override）ので agent 品質で書く。
//   - method レベルの網羅・追随は当面手動同期（将来 daemon dispatch 側も KDL codegen 化 =
//     doc 27「1 protocol」方向。open）。
//
// starter set（2026-07-11 user 確定 → Phase1 は registry + events を先行）:
//   handshake なしの純 request/response ＝ 無改造 unison-mcp で即 round-trip 可能な channel を採用。
//   repo-proxy は subscribe handshake 前提（unison-mcp 未対応）＋要 repo 起動のため follow-up
//   （creo mem_1CcuR73WSNFkyAgzVJvWyF ＝ unison-mcp の handshake 対応 or daemon auto-subscribe が要る）。
// 2026-07-12 拡張: daemon-control の read-safe subset（hub/discover）を追加 — hub registry の
//   nodes 一覧 + connected liveness（hub protocol v0.7.0）を MCP から照会可能にする。
//   repos/* mutation は手で叩くと repos.kdl 状態を壊すため記述しない（registry と同じ方針）。

protocol "vp-daemon" version="0.2.0" {
    namespace "club.chronista.vantage-point"

    // registry channel: repo 自己登録 + running process / lane registry の control plane。
    // handler: server.rs register_channel("registry", ...)（match method: register / unregister /
    // heartbeat / list / lanes/add / lanes/remove / lanes/update）。
    // starter では read-safe な `list` のみ記述する。register / unregister / heartbeat は repo 内部用
    //（手で叩くと registry 状態を壊す）、lanes/* は mutation なので follow-up で記述する。
    channel "registry" from="client" lifetime="persistent" {
        request "list" description="VP daemon に登録中の全 running process（repo / 各 repo の repo）の snapshot を返す read-only 照会。`vp ps` 相当を daemon から直接引く。引数なし。" {
            returns "ProcessList" {
                field "processes" type="json" required=#true description="running process の配列。各要素は { repo_name, port, pid, repo_path }。"
            }
        }
    }

    // daemon-control channel: daemon 権威の control plane（CLI → Daemon 直接 Unison）。
    // handler: server.rs handle_daemon_control（match method: repos/* + lanes/* + hub/discover + ping）。
    //
    // ここには read-safe な request だけ記述する（hub/discover / lanes/list）。mutation は
    // 手で叩くと repos.kdl / lane descriptor の状態を壊すため記述しない（unison-mcp に
    // 露出させない）。この「意図的に書かない」判断は tests/vp_daemon_kdl.rs の
    // DAEMON_CONTROL_OMITTED_BY_DESIGN と対になっていて、handler に method を足したのに
    // KDL にも omission list にも入れなかった場合はテストが落ちる（= 露出/非露出を
    // 無意識に決めてしまうことを防ぐ）。
    //
    // doc 45 段 1（2026-07-22）: HTTP `/api/daemon/*` にしか無かった面を handler へ移設した
    // （repos/update・repos/sync・repos/reload・repos/restart・repos/pointview・
    // lanes/create・lanes/set_active）。全て mutation なので上記方針どおり omission 側に置く。
    channel "daemon-control" from="client" lifetime="persistent" {
        request "hub/discover" description="chronista-hub registry に登録された daemon 一覧を返す federation discovery。daemon が credential 付きで hub の nodes.Discover を叩く（SSOT: hub と話すのは daemon のみ）。各 entry の connected (bool) は hub との常駐接続が今生きているかの liveness — false は registry に居るが relay は offline を返す (stale / 切断中)。hub addr 未設定（env CHRONISTA_HUB_ADDR / config.kdl hub-addr）ならエラーを返す。引数なし。" {
            returns "DaemonList" {
                field "nodes" type="json" required=#true description="daemon の配列。各要素は { node_id, handle, name, endpoints[], registered_at, connected }。connected=true は relay 到達可、false は offline (stale entry / 切断中)。"
            }
        }
        request "lanes/list" description="全 repo 横断の lane 一覧を返す read-only 照会。各 lane は repo / name (開発起点は予約名 root) / agent / state (spawning|running|exiting|dead) を持つ。`vp ps` の LANES / STATUS 列や外部 agent の俯瞰に使う。repo 単位の詳細操作は repo-proxy 経由。全ての引数は省略可で、省略 = 絞り込みなし。並びは repo 名昇順 → 同 repo 内は開発起点 (root) が先 → 作成順。" {
            field "repo" type="string" description="repo 名で絞り込む（LaneAddress.repo と完全一致）。省略時は全 repo。"
            field "lane" type="string" description="lane 名で絞り込む（開発起点は予約名 \"root\"、performer は作成時の名前）。省略時は全 lane。"
            field "agent" type="string" description="agent で絞り込む（例 \"claude\" / \"shell\"）。省略時は全 agent。"
            returns "LaneList" {
                field "count" type="int" required=#true description="filter 適用後の lane 件数（lanes 配列の長さ）。"
                field "lanes" type="json" required=#true description="LaneInfo の配列。各要素は { address: { repo, name }, state, agent, ... }。"
            }
        }
        request "host/farewell_log" description="Repo Host の帳簿から見送りの記録を新しい順に返す read-only 照会（doc 44 §7.5）。kind='reclaimed' が「いつ何を見送ったか」、kind='pending' が「人の判断待ちがいつから何回続いているか」。lane_name は記録時点のスナップショット（key は lane_id なので rename でも履歴は動かない）。" {
            field "path" type="string" required=#true description="対象 repo の path（内部で正規化して照合する）。"
            field "limit" type="int" description="返す件数の上限。0 / 省略は無制限。"
            returns "FarewellLog" {
                field "entries" type="json" required=#true description="記録の配列（last_seen_at の降順）。各要素は { lane_id, lane_name, kind: reclaimed|pending, reason, streak, first_seen_at, last_seen_at, ongoing }。streak は同じ判定が連続した回数（実行回数であって日数ではない）。"
            }
        }
    }

    // events channel: daemon の event log（doc 27 §5-3。process.up / process.down を baseline に蓄積、
    // build/test 等の追加 source は follow-up）。
    // handler: server.rs register_channel("events", ...)（match method: emit / query）。
    channel "events" from="client" lifetime="persistent" {
        request "query" description="daemon の event log を時系列で照会する read-only 面。seq が `since` より後の event を最大 `limit` 件返す（seq 昇順）。" {
            field "since" type="int" description="この seq より後の event を返す。0 なら先頭から。"
            field "limit" type="int" description="取得件数の上限。0 は無制限。"
            returns "EventPage" {
                field "events" type="json" required=#true description="event の配列（seq 昇順）。各要素は { seq, kind, source?, data, ... }。"
            }
        }

        request "emit" description="任意の event を daemon の event log に注入する（dogfood / デバッグ用の手動 emit）。" {
            field "kind" type="string" required=#true description="event 種別（例 \"process.up\" / \"build.start\"）。空文字は拒否される。"
            field "source" type="string" description="発生源ラベル（任意、例 repo 名）。"
            field "data" type="json" description="任意の付随データ（JSON オブジェクト等）。"
            returns "EmitAck" {
                field "seq" type="int" required=#true description="採番された単調増加の event seq。"
            }
        }
    }
}
